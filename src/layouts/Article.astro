---
const { item, back, nav, siteName } = Astro.props;
const base = import.meta.env.BASE_URL;
function paras(s) {
  return String(s || "").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{item.title} | {siteName}</title>
  <meta name="description" content={item.summary}>
  <base href={base}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,650;12..96,800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/css/style.css">
</head>
<body data-nav={nav}>
<header id="site-header"></header>
<main>
<article id="detail" data-back={back} data-astro="1">
  <a class="back" href={back}>Back to list</a>
  <span class="tag">{item.tag}, {item.year}</span>
  <h1>{item.title}</h1>
  <p class="lede">{item.summary}</p>
  <div class="art" style={`--h:${item.h}`} aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i></div>
  {item.body.map((section) => (
    <>
      {section.heading ? <h2>{section.heading}</h2> : null}
      {paras(section.text).map((p) => <p>{p}</p>)}
    </>
  ))}
</article>
</main>
<footer id="site-footer"></footer>
<script is:inline src="assets/js/data.js"></script>
<script is:inline src="assets/js/main.js"></script>
</body>
</html>
